<?xml version="1.0" encoding="utf-8"?>
<!-- Ask Athena: a search bar; the bar opens the sheet with the keyboard, the mic opens it listening. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ask_bar"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ask_bar_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="6dp">
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/ask_hint"
        android:textColor="@color/tone_quiet"
        android:textSize="16sp" />
    <ImageView
        android:id="@+id/ask_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/ask_mic_bg"
        android:contentDescription="@string/ask_mic"
        android:padding="10dp"
        android:src="@drawable/ic_mic" />
</LinearLayout>
